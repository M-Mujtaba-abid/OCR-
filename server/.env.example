# Copy to .env and fill in. NEVER commit .env — it is gitignored.

ENVIRONMENT=local
DEBUG=true

# Neon: use the POOLED connection string (host contains "-pooler") for the app.
# Alembic migrations later need the DIRECT string (no "-pooler").
# sslmode / channel_binding are stripped automatically in app/core/config.py
# because asyncpg does not accept them.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

CORS_ORIGINS=["http://localhost:3000"]
