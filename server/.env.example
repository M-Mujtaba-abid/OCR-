# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# ---------------------------------------------------------------- app
PROJECT_NAME=OCR API
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # MUST be false in production

# Mount point for the versioned API. The frontend appends this itself, so
# changing it here means changing client/service/api.ts too.
API_V1_PREFIX=/api/v1

# Comma-separated or a JSON array. Must list the exact frontend origin —
# a wildcard cannot be combined with credentialed (cookie) requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- database
# Neon: use the POOLED connection string (host contains "-pooler") for the app.
# Alembic migrations use the DIRECT string (no "-pooler") — see alembic/env.py.
# sslmode / channel_binding are stripped automatically in app/core/config.py
# because asyncpg does not accept them.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional. Falls back to DATABASE_URL with "-pooler" removed if unset.
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Test a pooled connection before handing it out. Off by default: measured
# against a Neon instance a continent away it cost ~1.9 SECONDS per request,
# because a failed ping rebuilds the connection — TLS handshake included — on
# requests that were fine. pool_recycle discards stale connections by age
# instead, which costs no network. Turn on only if connections start FAILING
# rather than being slow; on a database in the same region the ping is cheap.
# DB_POOL_PRE_PING=false

# Keep the database in the same region as the API server. Every round trip to
# a database on another continent measured ~500 ms here, and a request makes
# several — which no amount of query tuning can recover.

# ---------------------------------------------------------------- JWT
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this invalidates every issued access token immediately.
JWT_SECRET_KEY=change-me-generate-a-real-64-byte-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------- auth cookies
AUTH_COOKIE_NAME=refresh_token
# MUST be true in production. A refresh token sent over plain HTTP is readable
# by anyone on the network path.
AUTH_COOKIE_SECURE=false
# lax  — frontend and API share a site (recommended; blocks CSRF)
# none — different sites; REQUIRES AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Scoped so the cookie is not attached to every ordinary API call.
AUTH_COOKIE_PATH=/api/v1/auth
# AUTH_COOKIE_DOMAIN=.example.com

# ------------------------------------------------------- storage (Cloudflare R2)
# Dashboard -> R2 -> Overview. The 32-hex account id, NOT the bucket name.
# The S3 endpoint is derived from it: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
#   Permission: "Object Read & Write", scoped to this bucket only.
# The secret is shown ONCE at creation. These are credentials — treat them
# exactly like DATABASE_URL and never commit them.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET_NAME=ap-invoices

# Optional. A custom domain (Bucket -> Settings -> Custom Domains) or the
# r2.dev development URL. Set this ONLY if the bucket is meant to be publicly
# readable — anyone with the URL can read any object under it.
# Leave blank for a private bucket; the app then issues presigned URLs instead.
# R2_PUBLIC_URL=https://files.example.com

# Rejected while streaming, before the whole body is buffered.
UPLOAD_MAX_SIZE_MB=10

# ------------------------------------------------------- OCR / AI (Mistral)
# console.mistral.ai -> API Keys. Required for extraction; without it uploads
# still land but stay in `uploaded` and a 503 is returned on demand.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_CHAT_MODEL=mistral-large-latest
# The reranker's model. Empty means "same as the chat model". Choosing between
# a handful of already-scored candidates is a far narrower job than reading a
# document, so a cheaper model may well do — but measure it on real invoices
# with scripts/measure_rerank_cost.py and the corrected rate before switching.
# MISTRAL_RERANK_MODEL=mistral-small-latest

# The kill switch. Every upload costs money once extraction runs automatically;
# set false to revert to admin-triggered processing without a code change.
OCR_AUTO_ON_UPLOAD=true

# WHERE extraction runs, not whether it does. Leave false on a serverless
# platform: a background task queued during the upload request runs INSIDE the
# invocation the browser is waiting on, so the upload button spins through
# every Mistral call. False means the upload returns as soon as the rows are
# committed and the client starts each invoice with its own call to
# /invoices/{id}/start - which also extracts the files in parallel. Set true
# for a long-lived server (uvicorn sends the response before the task runs) or
# for a client that will not make that second call. Nothing is stranded either
# way: the cron sweep starts anything left sitting in `uploaded`.
# OCR_IN_UPLOAD_REQUEST=false

# Mistral caps document annotation at 8 pages. Past this the service falls back
# to plain OCR followed by a chat pass over the markdown.
OCR_MAX_ANNOTATION_PAGES=8

# How long the signed URL handed to Mistral stays valid, in seconds.
OCR_SIGNED_URL_TTL=600

# ---------------------------------------------------------------- secrets
# Encrypts the per-company Odoo API keys held in the database. REQUIRED as soon
# as any company saves its own Odoo credentials.
#
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Losing or changing this makes every stored credential unreadable — companies
# then have to re-enter their API keys. Back it up with the database, and never
# store it in the database.
SECRETS_ENCRYPTION_KEY=

# ------------------------------------------------------------------- Odoo
# THE FALLBACK, not the source of truth. Each company configures its own Odoo
# at PUT /api/v1/company/odoo, and a company that has done so never reads these.
# A company with no configuration of its own uses what is set here — which is
# what keeps a single-company deployment working exactly as it always did.
#
# Base host only — NOT the browser URL. XML-RPC lives at /xmlrpc/2/*, so
# https://you.odoo.com is right and https://you.odoo.com/odoo/purchase is not.
ODOO_URL=
# Usually the same as the host on Odoo.sh / hosted installs. Find it at
# <ODOO_URL>/web/database/selector if unsure.
ODOO_DB=
# The Odoo login email. The API key below MUST belong to this same user.
ODOO_USERNAME=
# Preferences -> Account Security -> New API Key
ODOO_API_KEY=

# Which purchase orders are eligible for matching. Deployment-specific: some
# companies invoice off `done` orders, others never leave `purchase`.
ODOO_PO_STATES=purchase,done
ODOO_PO_INVOICE_STATUSES=to invoice
ODOO_PO_FETCH_LIMIT=500
# How long one fetch's result is reused. A twenty-file upload otherwise runs
# twenty identical reads of the same few hundred orders, seconds apart, and the
# queue waits for each. 0 disables the cache.
ODOO_FETCH_CACHE_SECONDS=60

# Before raising a purchase order, look this far back for an identical draft
# for the same vendor and the same untaxed total, and return that instead of
# creating a second one. A create that reaches Odoo but fails on the way back
# leaves this side knowing nothing, and the reviewer's next click would
# otherwise become another order. 0 disables the check.
ODOO_PO_DUPLICATE_WINDOW_MINUTES=10

# The largest scan to push into Odoo as an attachment on a vendor bill.
#
# Lower than the upload limit for a reason: base64 inflates the payload by 4/3
# and XML-RPC builds the whole request in memory, so a 10 MB scan is a ~14 MB
# body. What usually rejects it is not Odoo but the reverse proxy in front of
# it — nginx's client_max_body_size defaults to 1 MB — and that arrives as an
# HTTP 413 with nothing useful in it. Anything larger is skipped and reported
# as such; the bill is still created.
ODOO_ATTACHMENT_MAX_MB=10

# Orders Odoo has ALREADY billed are also scored, back this many days from the
# invoice's own date. Without it a late or duplicate vendor invoice matches
# nothing at all — Odoo flips the order to "invoiced" and it drops out of the
# search — and the screen cannot tell "already billed" from "does not exist".
# Such candidates are shown badged, never preferred. 0 turns the sweep off.
MATCH_CLOSED_LOOKBACK_DAYS=90

# A JSON file of purchase orders to use INSTEAD of a live Odoo, for local work.
# Ignored the moment ODOO_URL is filled in, so it can never shadow the real
# thing. Generate one with scripts/seed_purchase_orders.py
# ODOO_FIXTURE_PATH=fixtures/purchase_orders.json

# --------------------------------------------------------------- matching
# How many candidates reach the LLM. This is the number that keeps the design
# affordable: the model sees 15 orders, never 5000.
MATCH_CANDIDATE_LIMIT=15
# Below this a candidate is not worth showing the model at all.
MATCH_SCORE_FLOOR=35
# Below this the verdict is recorded as no_match rather than a weak guess.
MATCH_MIN_CONFIDENCE=70

# ------------------------------------------------------- prompt economy
# The settings above decide what the REVIEW SCREEN keeps — every candidate
# considered, which is what makes a wrong match arguable afterwards. These
# decide which of them are worth paying tokens to describe to the model.
#
# A candidate this far below the leader is not what the model picks; it is
# only what the model is billed for. Where the top of the list is tied,
# nothing is trimmed and the full spend goes on the decision that needs it.
MATCH_PROMPT_MARGIN=25
# Never describe fewer than this, however far ahead the leader is.
MATCH_PROMPT_MIN=5
# Line rows per candidate in the prompt. The line-item score is computed in
# code over every line regardless; these rows are evidence, not the score.
MATCH_PROMPT_ITEM_CAP=12

# When the prefilter's answer is beyond argument, the model is not asked at
# all. Deliberately strict: it requires the vendor to have quoted the order's
# reference EXACTLY, plus this score and this gap to the runner-up. An order
# Odoo has already billed never qualifies — that is the duplicate case.
# Set the score above 100 to switch the fast path off entirely.
MATCH_AUTO_ACCEPT_SCORE=95
MATCH_AUTO_ACCEPT_MARGIN=20

# ---------------------------------------------------------------- uploads
MAX_FILES_PER_UPLOAD=10

# How long after a token is rotated that re-presenting it counts as a duplicate
# rather than theft. Protects clients that fire two refreshes at once (a retry,
# a double-click, two tabs) from having every session revoked. 0 disables it.
REFRESH_REUSE_GRACE_SECONDS=10

# ------------------------------------------------------------ deployment
# Scheduled maintenance secret. Vercel Cron sends it as
# `Authorization: Bearer <secret>`; /internal/cron/sweep refuses everything
# when it is empty, because an open endpoint that re-queues OCR work is a free
# way for anybody to spend the Mistral budget.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# Cookie policy. `lax` works only when the frontend and API share a site.
# Two Vercel projects means two origins, and there the browser silently drops
# the refresh cookie on `lax` — every session dies at the access token's expiry
# with nothing in any log to explain it. Cross-origin REQUIRES:
#   AUTH_COOKIE_SAMESITE=none
#   AUTH_COOKIE_SECURE=true
#
# In production these are enforced at startup: DEBUG=false and
# AUTH_COOKIE_SECURE=true, or the process refuses to boot.

# ODOO_FIXTURE_PATH is DEVELOPMENT ONLY. It serves invented purchase orders,
# and in production the app raises rather than start with it set — see
# `_enforce_production_safety`. Never put it in a production environment.

# How long an invoice may sit mid-pipeline before the cron sweeper presumes its
# processing was cut short and starts it again. Keep it comfortably above the
# platform's function timeout, or a merely-slow job is restarted underneath
# itself.
STUCK_AFTER_MINUTES=10

# Approval chains. How long one step may sit undecided before the sweep nudges
# whoever it is waiting on (and how often it repeats), and when it stops nudging
# only them and tells the company's administrators too.
#
# An approval chain's real failure is being forgotten rather than refused: a
# request sits on somebody who is on leave, nothing mentions it again, and the
# invoice surfaces weeks later when the vendor chases it.
APPROVAL_REMIND_AFTER_HOURS=24
APPROVAL_ESCALATE_AFTER_HOURS=72

# How long a READ notification is kept before the nightly cleanup deletes it.
# Unread ones are never deleted by age: removing something a person never saw is
# the one version of this they cannot recover from.
#
# The table has no other bound — nothing else in the system deletes from it — so
# this is what stops a year-old account carrying thousands of rows through every
# unread count.
NOTIFICATION_RETENTION_DAYS=90

# Signed-URL lifetimes, in seconds.
#   upload   — how long a browser has to PUT one file straight to storage
#   download — a link minted on click; short, because it can be forwarded
UPLOAD_SIGNED_URL_TTL=900
DOWNLOAD_SIGNED_URL_TTL=300
