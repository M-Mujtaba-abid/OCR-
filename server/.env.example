# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# ---------------------------------------------------------------- app
PROJECT_NAME=OCR API
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # MUST be false in production

# Comma-separated or a JSON array. Must list the exact frontend origin —
# a wildcard cannot be combined with credentialed (cookie) requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- database
# Neon: use the POOLED connection string (host contains "-pooler") for the app.
# Alembic migrations use the DIRECT string (no "-pooler") — see alembic/env.py.
# sslmode / channel_binding are stripped automatically in app/core/config.py
# because asyncpg does not accept them.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional. Falls back to DATABASE_URL with "-pooler" removed if unset.
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------- JWT
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this invalidates every issued access token immediately.
JWT_SECRET_KEY=change-me-generate-a-real-64-byte-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------- auth cookies
AUTH_COOKIE_NAME=refresh_token
# MUST be true in production. A refresh token sent over plain HTTP is readable
# by anyone on the network path.
AUTH_COOKIE_SECURE=false
# lax  — frontend and API share a site (recommended; blocks CSRF)
# none — different sites; REQUIRES AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Scoped so the cookie is not attached to every ordinary API call.
AUTH_COOKIE_PATH=/api/v1/auth
# AUTH_COOKIE_DOMAIN=.example.com

# ------------------------------------------------------- storage (Cloudflare R2)
# Dashboard -> R2 -> Overview. The 32-hex account id, NOT the bucket name.
# The S3 endpoint is derived from it: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
#   Permission: "Object Read & Write", scoped to this bucket only.
# The secret is shown ONCE at creation. These are credentials — treat them
# exactly like DATABASE_URL and never commit them.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET_NAME=ap-invoices

# Optional. A custom domain (Bucket -> Settings -> Custom Domains) or the
# r2.dev development URL. Set this ONLY if the bucket is meant to be publicly
# readable — anyone with the URL can read any object under it.
# Leave blank for a private bucket; the app then issues presigned URLs instead.
# R2_PUBLIC_URL=https://files.example.com

# Rejected while streaming, before the whole body is buffered.
UPLOAD_MAX_SIZE_MB=10

# ------------------------------------------------------- OCR / AI (Mistral)
# console.mistral.ai -> API Keys. Required for extraction; without it uploads
# still land but stay in `uploaded` and a 503 is returned on demand.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_CHAT_MODEL=mistral-large-latest

# The kill switch. Every upload costs money once extraction runs automatically;
# set false to revert to admin-triggered processing without a code change.
OCR_AUTO_ON_UPLOAD=true

# Mistral caps document annotation at 8 pages. Past this the service falls back
# to plain OCR followed by a chat pass over the markdown.
OCR_MAX_ANNOTATION_PAGES=8

# How long the signed URL handed to Mistral stays valid, in seconds.
OCR_SIGNED_URL_TTL=600

# ------------------------------------------------------------------- Odoo
# Base host only — NOT the browser URL. XML-RPC lives at /xmlrpc/2/*, so
# https://you.odoo.com is right and https://you.odoo.com/odoo/purchase is not.
ODOO_URL=
# Usually the same as the host on Odoo.sh / hosted installs. Find it at
# <ODOO_URL>/web/database/selector if unsure.
ODOO_DB=
# The Odoo login email. The API key below MUST belong to this same user.
ODOO_USERNAME=
# Preferences -> Account Security -> New API Key
ODOO_API_KEY=

# Which purchase orders are eligible for matching. Deployment-specific: some
# companies invoice off `done` orders, others never leave `purchase`.
ODOO_PO_STATES=purchase,done
ODOO_PO_INVOICE_STATUS=to invoice
ODOO_PO_FETCH_LIMIT=500

# A JSON file of purchase orders to use INSTEAD of a live Odoo, for local work.
# Ignored the moment ODOO_URL is filled in, so it can never shadow the real
# thing. Generate one with scripts/seed_purchase_orders.py
# ODOO_FIXTURE_PATH=fixtures/purchase_orders.json

# --------------------------------------------------------------- matching
# How many candidates reach the LLM. This is the number that keeps the design
# affordable: the model sees 15 orders, never 5000.
MATCH_CANDIDATE_LIMIT=15
# Below this a candidate is not worth showing the model at all.
MATCH_SCORE_FLOOR=35
# Below this the verdict is recorded as no_match rather than a weak guess.
MATCH_MIN_CONFIDENCE=70

# ---------------------------------------------------------------- uploads
MAX_FILES_PER_UPLOAD=10
