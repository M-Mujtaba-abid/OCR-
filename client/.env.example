# Backend API origin. NO trailing slash — the client appends /api/v1.
#
# Use localhost consistently on BOTH sides. If the browser is on
# http://localhost:3000 but this points at http://127.0.0.1:8000, the refresh
# cookie is scoped to a different host and silently never gets sent.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production example:
# NEXT_PUBLIC_API_URL=https://api.example.com