# Backend origin. NO trailing slash and NO /api — service/api.ts appends the
# version prefix itself, so this is the single place the host is written down.
#
# Use localhost consistently on BOTH sides. If the browser is on
# http://localhost:3000 but this points at http://127.0.0.1:8000, the refresh
# cookie is scoped to a different host and silently never gets sent.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Production example:
# NEXT_PUBLIC_BACKEND_URL=https://api.example.com

# Optional UI tuning. All have working defaults, so the two lines above are the
# only ones a deployment must set. Inlined at BUILD time by Next.js — changing
# one in Vercel needs a redeploy to take effect.
#
# Upload limits are deliberately NOT here. The server owns them and serves them
# from /api/v1/config; a copy in this file would be a second source of truth
# that disagrees the moment one side changes.
# NEXT_PUBLIC_API_PREFIX=/api/v1
#
# Set to false to post invoice bytes through the API instead of straight to
# object storage. An escape hatch for a bucket with no CORS policy yet, not a
# deployment setting: the API path is capped by the serverless body limit
# (~4.5 MB) and a scanned invoice routinely exceeds it. Fix the bucket instead —
# server/scripts/set_r2_cors.py --show
# NEXT_PUBLIC_DIRECT_UPLOAD=true
# NEXT_PUBLIC_POLL_MS=3000
# How often the notification badge and the approvals queue check for work
# somebody ELSE created. A different job from POLL_MS above, which tracks work
# this browser started and stops as soon as it finishes — this one never stops,
# so every open tab pays it. Trades serverless invocations against how long a
# badge may be wrong.
# NEXT_PUBLIC_NOTIFICATION_POLL_MS=30000
# NEXT_PUBLIC_PAGE_SIZE=10
# NEXT_PUBLIC_UPLOAD_TIMEOUT_MS=120000
# NEXT_PUBLIC_REQUEST_TIMEOUT_MS=30000
